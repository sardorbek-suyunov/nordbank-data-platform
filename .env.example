# Copy to .env and adjust. .env is gitignored and must never be committed.
# Every value below is a placeholder; none of them is a working credential.

# --- Platform ---------------------------------------------------------------
NORDBANK_ENV=dev                      # ci, dev or full; scale profiles are defined in docs/architecture.md
TZ=UTC                                # process timezone; the platform stores timestamps in UTC only
BASE_CURRENCY=EUR                     # reporting currency all amounts are converted to

# --- Source system: Postgres ------------------------------------------------
POSTGRES_HOST=localhost               # hostname of the synthetic core banking database
POSTGRES_PORT=5432                    # port exposed by the Postgres container
POSTGRES_DB=nordbank_core             # database holding the core and ref schemas
POSTGRES_USER=nordbank                # owner of the core and ref schemas
POSTGRES_PASSWORD=change-me           # password for POSTGRES_USER
POSTGRES_READ_USER=nordbank_reader    # read-only role used by extraction tasks
POSTGRES_READ_PASSWORD=change-me      # password for POSTGRES_READ_USER
EXTRACT_LAG_MINUTES=15                # overlap re-read on every incremental extraction, against boundary ties and late commits

# --- Lake: MinIO ------------------------------------------------------------
MINIO_ENDPOINT=http://localhost:9000  # S3 API endpoint of the MinIO container
MINIO_ROOT_USER=minio                 # MinIO administrator account
MINIO_ROOT_PASSWORD=change-me         # password for MINIO_ROOT_USER
MINIO_BUCKET=nordbank-lake            # bucket holding the bronze parquet partitions
MINIO_REGION=eu-central-1             # region string required by the S3 client

# --- Warehouse: DuckDB ------------------------------------------------------
DUCKDB_PATH=/opt/warehouse/nordbank.duckdb  # single warehouse file; writers serialise on it
DUCKDB_READ_ONLY=false                # readers set this to true, per ADR 0002

# --- Orchestration: Airflow -------------------------------------------------
AIRFLOW_UID=50000                     # uid owning the Airflow volumes on Linux hosts
AIRFLOW_PROJ_DIR=./airflow            # Airflow home mounted into the containers
AIRFLOW__CORE__FERNET_KEY=            # generated per environment; empty disables connection encryption
AIRFLOW__CORE__LOAD_EXAMPLES=false    # example DAGs stay out of the DAG list
AIRFLOW_ADMIN_USER=admin              # initial Airflow web user
AIRFLOW_ADMIN_PASSWORD=change-me      # password for AIRFLOW_ADMIN_USER
AIRFLOW_WEB_PORT=8080                 # host port for the Airflow web interface

# --- Transformation: dbt ----------------------------------------------------
DBT_TARGET=duckdb                     # active dbt target: duckdb or bigquery
DBT_PROFILES_DIR=./dbt                # directory holding profiles.yml
DBT_THREADS=4                         # dbt thread count; DuckDB writes remain serialised

# --- Secondary target: BigQuery --------------------------------------------
GCP_PROJECT_ID=nordbank-sandbox       # project holding the BigQuery sandbox dataset
GCP_DATASET=nordbank_gold             # dataset the BigQuery target writes to
GCP_LOCATION=europe-west3             # dataset location
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json  # key file path; the file is gitignored

# --- External sources -------------------------------------------------------
FRANKFURTER_BASE_URL=https://api.frankfurter.app  # ECB reference rates, no key required
FRED_API_KEY=change-me                # FRED API key for the macro indicator feed
FRED_SERIES=CPIAUCSL,UNRATE           # comma-separated FRED series ingested monthly
OPENSANCTIONS_URL=https://data.opensanctions.org/datasets/latest/default/entities.ftm.json  # sanctions and PEP snapshot
CARD_SETTLEMENT_PREFIX=incoming/card_network  # bucket prefix the settlement files land under

# --- Generator --------------------------------------------------------------
GENERATOR_SEED=20260101               # seed that makes a generated dataset reproducible
GENERATOR_START_DATE=2023-01-01       # first business date of the historical load
GENERATOR_CUSTOMERS=5000              # customer count for dev; ci uses about 500 and full about 250000

# --- Privacy ----------------------------------------------------------------
PII_TOKEN_SALT=change-me              # key for identifier tokenisation at ingest; rotating it invalidates every token and join

# --- Consumption ------------------------------------------------------------
STREAMLIT_PORT=8501                   # host port for the Streamlit application
