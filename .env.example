# This file documents variables. It contains no working secret and never will.
#
# Two sentinels appear as values:
#   __GENERATE__  `make init-env` replaces it with a freshly generated value, and `make up`
#                 runs that generation itself when .env is missing, so a clean clone needs no
#                 manual step.
#   __EXTERNAL__  a credential issued by somebody else. Nothing needs one before M5; the
#                 preflight reports them rather than failing.
#
# .env is gitignored and must never be committed. The setting most likely to differ per machine
# is the memory Docker Desktop is allowed to use; see docs/runbook.md. AIRFLOW_UID is the one
# people are tempted to change and should not.

# --- Platform ---------------------------------------------------------------
NORDBANK_ENV=dev                      # ci, dev or full; scale profiles are defined in docs/architecture.md
NORDBANK_SEED=42                      # integer; one of the three inputs that determine the generated data
NORDBANK_ANCHOR_DATE=                 # ISO date, the simulated "today"; empty means the real current date
TZ=UTC                                # process timezone; the platform stores timestamps in UTC only
BASE_CURRENCY=EUR                     # reporting currency all amounts are converted to
AIRFLOW_UID=50000                     # leave this alone: Airflow is installed in this user's home in the image, and every writable path is a named volume

# --- Source database: Postgres ----------------------------------------------
POSTGRES_SOURCE_SUPERUSER=nordbank_admin        # bootstrap superuser, used only by the init scripts
POSTGRES_SOURCE_SUPERUSER_PASSWORD=__GENERATE__ # password for the bootstrap superuser
POSTGRES_SOURCE_DB=nordbank                     # database holding the core and ref schemas
POSTGRES_SOURCE_PORT=15432                      # host port for the source database; deliberately not 5432, and deliberately below 49152, see docs/runbook.md
SOURCE_APP_USER=nordbank_app                    # owner of core and ref; the generator writes as this role
SOURCE_APP_PASSWORD=__GENERATE__                # password for SOURCE_APP_USER
SOURCE_READ_USER=nordbank_reader                # SELECT-only role; extraction authenticates as this and nothing else
SOURCE_READ_PASSWORD=__GENERATE__               # password for SOURCE_READ_USER
EXTRACT_LAG_MINUTES=15                          # overlap re-read on every incremental extraction, against boundary ties and late commits

# --- Airflow metadata database ----------------------------------------------
POSTGRES_AIRFLOW_USER=airflow          # Airflow metadata database owner, deliberately separate from the source
POSTGRES_AIRFLOW_PASSWORD=__GENERATE__ # password for POSTGRES_AIRFLOW_USER
POSTGRES_AIRFLOW_DB=airflow            # Airflow metadata database name
POSTGRES_AIRFLOW_PORT=5433             # host port, offset so both databases can be reached at once

# --- Lake: MinIO ------------------------------------------------------------
MINIO_ROOT_USER=minio                 # MinIO administrator account
MINIO_ROOT_PASSWORD=__GENERATE__      # password for MINIO_ROOT_USER; MinIO requires at least 8 characters
MINIO_API_PORT=9000                   # host port for the S3 API
MINIO_CONSOLE_PORT=9001               # host port for the MinIO console
LAKE_BUCKET=nordbank-lake             # bucket holding the bronze parquet partitions and quarantine

# --- S3 settings for DuckDB httpfs and boto3 --------------------------------
AWS_ACCESS_KEY_ID=minio               # matches MINIO_ROOT_USER; DuckDB httpfs and boto3 read the AWS names
AWS_SECRET_ACCESS_KEY=__GENERATE__    # generated to match MINIO_ROOT_PASSWORD
AWS_REGION=eu-central-1               # region string the S3 client requires; MinIO ignores the value
AWS_ENDPOINT_URL=http://minio:9000    # S3 endpoint as seen from inside the compose network
AWS_S3_USE_SSL=false                  # the local endpoint is plain HTTP; never false against a real endpoint

# --- Warehouse: DuckDB ------------------------------------------------------
DUCKDB_PATH=/opt/warehouse/nordbank.duckdb  # warehouse file inside the container, on a named volume
# There is no warehouse Airflow connection: DuckDB has no connection type, and a connection
# with no hook behind it would imply Airflow manages the file. Access goes through
# airflow/plugins/nordbank_ops/warehouse.py, which owns the path, the read-only flag, the retry
# and the warehouse_access pool discipline.

# --- Orchestration: Airflow -------------------------------------------------
AIRFLOW_WEB_PORT=8080                 # host port for the Airflow UI and API
AIRFLOW_FERNET_KEY=__GENERATE__       # 32 random bytes, urlsafe base64, generated by make init-env
AIRFLOW_JWT_SECRET=__GENERATE__       # signs the task execution API tokens
AIRFLOW_ADMIN_USER=admin              # initial Airflow web user, created idempotently by airflow-init
AIRFLOW_ADMIN_PASSWORD=__GENERATE__   # password for AIRFLOW_ADMIN_USER
AIRFLOW_ADMIN_FIRSTNAME=Nordbank      # first name on the admin account
AIRFLOW_ADMIN_LASTNAME=Platform       # last name on the admin account
AIRFLOW_ADMIN_EMAIL=platform@nordbank.invalid  # email on the admin account; the domain is deliberately unroutable
DAG_PROCESSOR_REFRESH_INTERVAL=30     # seconds between DAG folder scans; CI lowers this so a trigger does not wait a cycle

# --- Airflow connections ----------------------------------------------------
# Supplied as environment variables so that no connection is ever created in the UI (ADR 0007).
# They are deliberately invisible to the UI and to `airflow connections list`; read them back
# with `airflow connections get <id>`.
AIRFLOW_CONN_NORDBANK_SOURCE_DB=postgresql://nordbank_reader:__GENERATE__@postgres-source:5432/nordbank  # extraction reads as the SELECT-only role
AIRFLOW_CONN_NORDBANK_SOURCE_SIMULATOR=postgresql://nordbank_app:__GENERATE__@postgres-source:5432/nordbank  # ops_source_tick only: the simulation standing in for the source system's own operation, not the platform. See docs/architecture.md
AIRFLOW_CONN_NORDBANK_LAKE={"conn_type":"aws","login":"minio","password":"__GENERATE__","extra":{"endpoint_url":"http://minio:9000","region_name":"eu-central-1"}}  # JSON, because the endpoint override is unreadable percent-encoded into a URI

# --- Transformation: dbt ----------------------------------------------------
DBT_TARGET=duckdb                     # active dbt target: duckdb or bigquery
DBT_PROFILES_DIR=./dbt                # directory holding profiles.yml
DBT_THREADS=4                         # dbt thread count; warehouse access remains serialised by the pool

# --- Secondary target: BigQuery --------------------------------------------
GCP_PROJECT_ID=nordbank-sandbox       # project holding the BigQuery sandbox dataset
GCP_DATASET=nordbank_gold             # dataset the BigQuery target writes to
GCP_LOCATION=europe-west3             # dataset location
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json  # key file path; the file is gitignored

# --- External sources -------------------------------------------------------
FRANKFURTER_BASE_URL=https://api.frankfurter.app  # ECB reference rates, no key required
FRED_API_KEY=__EXTERNAL__             # FRED API key for the macro indicator feed
FRED_SERIES=CPIAUCSL,UNRATE           # comma-separated FRED series ingested monthly
OPENSANCTIONS_URL=https://data.opensanctions.org/datasets/latest/default/entities.ftm.json  # sanctions and PEP snapshot
CARD_SETTLEMENT_PREFIX=incoming/card_network  # bucket prefix the settlement files land under

# --- Generator --------------------------------------------------------------
GENERATOR_SEED=20260101               # seed that makes a generated dataset reproducible
GENERATOR_START_DATE=2023-01-01       # first business date of the historical load
GENERATOR_CUSTOMERS=5000              # customer count for dev; ci uses about 500 and full about 250000

# --- Privacy ----------------------------------------------------------------
PII_TOKEN_SALT=__GENERATE__           # key for identifier tokenisation at ingest; rotating it invalidates every token and join

# --- Consumption ------------------------------------------------------------
STREAMLIT_PORT=8501                   # host port for the Streamlit application
